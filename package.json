{
  "name": "auto-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "api": "npm run start:dev --workspace=apps/api",
    "api:build": "npm run build --workspace=apps/api",
    "db:dev": "npx convex dev",
    "db:push": "npx convex deploy",
    "db:seed": "npx convex run seed:seedAllCategories",
    "db:create-admin": "npx convex run seed:createInitialAdmin"
  },
  "devDependencies": {
    "convex": "^1.21.0",
    "expo": "~54.0.25"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "react-native-worklets": "^0.5.1"
  }
}
